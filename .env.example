# Ledger Recon Agent environment example
# Copy to .env for local development and fill values as needed.

# Optional repository root. It defaults to this checkout when unset.
APP_WORKSPACE_PATH=/path/to/ledger-recon-agent

# Any OpenAI-compatible service: a third-party provider or a self-hosted Colab API.
LLM_API_KEY=your-model-api-key
LLM_BASE_URL=https://example.com/v1
LLM_MODEL=your-model-name
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=600
LLM_MAX_TOKENS=
# Optional provider-specific request fields, for example: {"enable_thinking":false}
LLM_EXTRA_BODY_JSON={}

# Optional PostgreSQL checkpoint storage. If unset or unreachable, the app falls back
# to in-memory checkpoints that do not persist across restarts.
DATABASE_URL=postgresql://user:password@localhost:5432/ledger_recon

# Optional runtime tuning.
# Reconciliation batch size is passed as tool argument; default is 10000 rows.
# HTTP /run timeout is currently defined in src/main.py as TIMEOUT_SECONDS=900.
