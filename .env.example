# Ledger Recon Agent environment example
# Copy to .env for local development and fill values as needed.

# Optional repository root. It defaults to this checkout when unset.
APP_WORKSPACE_PATH=/path/to/ledger-recon-agent

# Any OpenAI-compatible service: a third-party provider or a self-hosted API.
LLM_API_KEY=your-model-api-key
LLM_BASE_URL=https://example.com/v1
LLM_MODEL=your-model-name
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=600
LLM_MAX_TOKENS=
# Optional provider-specific request fields, for example: {"enable_thinking":false}
LLM_EXTRA_BODY_JSON={}

# Optional PostgreSQL checkpoint storage. If unset or unreachable, the app falls back
# to in-memory checkpoints that do not persist across restarts.
DATABASE_URL=postgresql://user:password@localhost:5432/ledger_recon

# Optional runtime tuning.
# Reconciliation batch size is passed as tool argument; default is 10000 rows.
# HTTP /run timeout is currently defined in src/main.py as TIMEOUT_SECONDS=900.

# -----------------------------------------------------------------------------
# Optional Alibaba Cloud PAI Qwen3.6-27B-FP8 deployment script
# -----------------------------------------------------------------------------
# Preferred: use the model already published in PAI Model Gallery. This path
# does not download or upload model weights and does not need OSS.
# PAI_MODEL_SOURCE=builtin
# PAI_MODEL_NAME=Qwen3.6-27B-FP8
# PAI_MODEL_PROVIDER=pai
# PAI_MODEL_VERSION=
# PAI_REGION_ID=cn-hangzhou
# PAI_ACCESS_KEY_ID=replace-with-access-key-id
# PAI_ACCESS_KEY_SECRET=replace-with-access-key-secret
# PAI_INSTANCE_TYPE=your-gpu-instance-type
# PAI_WORKSPACE_ID=your-pai-workspace-id
# PAI_WAIT_FOR_READY=false
# PAI_SERVICE_NAME=qwen36-27b-fp8

# Fallback only: custom EAS deployment from your own OSS model directory.
# Set PAI_MODEL_SOURCE=custom before using these fields.
# PAI_MODEL_SOURCE=custom
# PAI_MODEL_PATH=oss://your-bucket/models/Qwen3.6-27B-FP8/
# PAI_VLLM_IMAGE=vllm/vllm-openai:v0.11.0
# PAI_GPU_COUNT=1
# PAI_TP=1
# PAI_MAX_MODEL_LEN=16384
# PAI_SAFETENSORS_LOAD_STRATEGY=
# PAI_SERVICE_TOKEN=
# PAI_VPC_ID=
# PAI_VSWITCH_ID=
# PAI_SECURITY_GROUP_ID=

# -----------------------------------------------------------------------------
# Optional Tencent Cloud TI-ONE Qwen3.6-27B-FP8 deployment script
# -----------------------------------------------------------------------------
# Preferred: use the model card already published in TI-ONE 大模型广场. This
# path does not download or upload model weights and does not need CFS.
# TIONE_MODEL_SOURCE=builtin
# TIONE_REGION=ap-guangzhou
# TIONE_BUILTIN_MODEL_ID=copy-the-model-card-id
# TIONE_BUILTIN_MODEL_NAME=Qwen3.6-27B
# TIONE_PUBLIC_ALGO_VERSION_ID=
# TC_SECRET_ID=replace-with-tencent-cloud-secret-id
# TC_SECRET_KEY=replace-with-tencent-cloud-secret-key
# TIONE_SERVICE_GROUP_NAME=qwen36-27b-fp8
# TIONE_INSTANCE_TYPE=your-tione-gpu-instance-type

# Fallback only: custom TI-ONE deployment from your own CFS model directory.
# Set TIONE_MODEL_SOURCE=custom before using these fields.
# TIONE_MODEL_SOURCE=custom
# TIONE_CFS_ID=cfs-xxxxxxxx
# TIONE_CFS_PATH=/models/Qwen3.6-27B-FP8
# TIONE_IMAGE_URL=mirror.ccs.tencentyun.com/vllm/vllm-openai:v0.11.0
# TIONE_IMAGE_TYPE=CUSTOM
# TIONE_TP=2
# TIONE_MAX_MODEL_LEN=16384
# TIONE_SERVICE_PORT=8000
# TIONE_DEPLOY_TYPE=STANDARD
# TIONE_INSTANCE_PER_REPLICA=2
# TIONE_AUTHORIZATION_ENABLE=true
# TIONE_SAFETENSORS_LOAD_STRATEGY=eager
